{
  "name": "longhouse-webapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Longhouse SPA \u2014 Zest components, TypeScript, Vite, and CBOR",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.6",
    "marked": "^18.0.4",
    "@catalystcommunity/base-components": "0.2.6",
    "@catalystcommunity/basic-data-service": "0.2.6",
    "@catalystcommunity/simple-router": "0.3.1",
    "@catalystcommunity/design-tokens": "0.1.1",
    "@catalystcommunity/date-time-picker": "0.2.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "happy-dom": "^20.9.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.6",
    "@testing-library/dom": "^10.4.1"
  }
}
